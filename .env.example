# Пример для локальной разработки: скопируйте в .env.local.
# Продакшен-адрес лежит в .env.production.
# На Vercel задайте эти переменные в Project → Settings → Environment Variables.

# Адрес бэкенда (без / в конце). Локально: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Таймаут запросов, мс (бесплатный Render «просыпается» до ~50 секунд)
VITE_API_TIMEOUT=60000
